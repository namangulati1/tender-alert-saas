# ─── Server ───────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── PostgreSQL ───────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=tender_alert

# ─── Redis ────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── WhatsApp Cloud API ──────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_access_token
WHATSAPP_VERIFY_TOKEN=your_verify_token

# ─── Razorpay ────────────────────────────────────────
RAZORPAY_KEY_ID=your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
RAZORPAY_PLAN_ID=your_plan_id

# ─── OpenAI ──────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# ─── JWT Authentication ──────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# ─── AI Providers ────────────────────────────────────
# FREE TIER OPTIONS (Recommended for development/testing):
#
# 1. Groq (RECOMMENDED FREE): 14,400 requests/day, 20/min
#    Sign up: https://console.groq.com
GROQ_API_KEY=your_groq_api_key
#
# 2. Google Gemini (FREE): 1,500 requests/day
#    Sign up: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key
#
# 3. OpenRouter (FREE tier): Various free models available
#    Sign up: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key
#
# PAID OPTIONS (Production use):
#
# 4. OpenAI (PAID): Pay per use
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
#
# 5. Anthropic Claude (PAID): Pay per use
ANTHROPIC_API_KEY=your_anthropic_api_key
#
# AI Provider Order (comma-separated)
# FREE TIER ORDER (default): groq,gemini,openrouter,openai,anthropic,local
# PAID ORDER: openai,anthropic,gemini,groq,local
AI_PROVIDER_ORDER=groq,gemini,openrouter,openai,anthropic,local
#
# Enable fallback to alternative providers when primary fails
AI_FALLBACK_ENABLED=true

# ─── Database Seeding ────────────────────────────────
# Set to 'true' to seed database with test data on startup
SEED_DATABASE=false
